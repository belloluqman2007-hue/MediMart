{
  "name": "medimart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -n API,Web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --import=tsx --watch apps/api/src/index.ts",
    "dev:web": "npm run dev -w @medimart/web",
    "build": "npm run build -w @medimart/api && npm run build -w @medimart/web",
    "start": "node --env-file-if-exists=.env apps/api/dist/index.js",
    "db:migrate": "node --env-file-if-exists=.env --import=tsx scripts/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:production",
    "android:sync": "node scripts/sync-android.mjs",
    "android:sync:dev": "node scripts/sync-android.mjs --development",
    "android:open": "npm exec -w @medimart/web -- cap open android",
    "android:apk": "node scripts/build-apk.mjs --profile debug",
    "android:apk:release": "node scripts/build-apk.mjs --profile release",
    "desktop:build": "node scripts/build-desktop.mjs",
    "icons:generate": "node scripts/generate-icons.mjs",
    "test:production": "node --import=tsx scripts/test-production.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@sparticuz/chromium": "153.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "packageManager": "npm@10.9.8",
  "overrides": {
    "minimatch": "11.0.4"
  }
}
