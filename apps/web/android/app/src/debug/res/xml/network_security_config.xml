<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY.

  A debug APK is what a shop uses for controlled testing: it can talk to the central computer over
  plain HTTP on the shop's private Wi-Fi, which needs no internet and no purchased certificate.
  Cleartext is enabled for private/local addresses and the device's own loopback. Release builds use
  the main network_security_config.xml, where cleartext is off.
-->
<network-security-config>
    <!-- Android 7.0/7.1 (API 24/25) only consult a network security config's cleartext rules for
         API 24+, and some OEM builds ignore base-config for plain sockets. The debug build is for
         a private shop LAN only; explicit domain-config entries make the allowance unambiguous. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">local</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
    </domain-config>
</network-security-config>
