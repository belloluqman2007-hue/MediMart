# Run npm run setup to create .env with a cryptographically random bootstrap token.
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
DATABASE_PATH=./var/medimart.sqlite
BOOTSTRAP_TOKEN=
# Explicit browser/native origins. Production must list the actual HTTPS application origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001,https://localhost
TRUST_PROXY_HOPS=0
SESSION_HOURS=8
# Production HTTPS deployments must keep cookies secure.
COOKIE_SECURE=false
# Used only by the Vite server, never by browser-facing code.
API_PROXY_TARGET=http://127.0.0.1:3001
